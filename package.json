{
  "name": "playwright-starter-repo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright v1.56+ automation starter kit for Squadap x Bluebird Masterclass",
  "scripts": {
    "test": "playwright test --project=chromium-v1",
    "test:v1": "playwright test --project=chromium-v1",
    "test:v2": "playwright test --project=chromium-v2",
    "test:smoke": "playwright test --project=chromium-v1 --grep @smoke",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.6.3"
  }
}
